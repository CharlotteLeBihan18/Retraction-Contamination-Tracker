# Copy this file to .env and fill in the values:  cp .env.example .env
# Never commit .env (it is in .gitignore).

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please
NEO4J_DATABASE=neo4j

# --- OpenAlex (free key from https://openalex.org/settings/api) ---
OPENALEX_API_KEY=

# --- LLM provider (used by /api/ask and /api/audit) ---
# Only Gemini is supported today (see the README, "LLM component").
# Leave LLM_API_KEY empty to run without AI: /api/ask and /api/audit then answer 503, everything else works.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash

# --- Nginx public port ---
NGINX_PORT=80

# --- Optional: LangSmith tracing of the AI calls (off by default, see the README, "Tracing") ---
# When on, the questions, abstracts and Gemini answers are sent to LangSmith.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=retraction-tracker
# EU accounts (eu.smith.langchain.com): https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
