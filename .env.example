# Copy this file to .env and fill in the values:  cp .env.example .env
# Never commit .env (it is in .gitignore).

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please
NEO4J_DATABASE=neo4j

# --- OpenAlex (free key from https://openalex.org/settings/api) ---
OPENALEX_API_KEY=

# --- LLM provider (used from milestone M4) ---
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# --- Nginx public port ---
NGINX_PORT=80
